+pub async fn best_effort_relay_shutdown(state: &AppState) {
+    let profiles = state
+        .with_workspaces(|store| Ok(store.list().to_vec()))
+        .unwrap_or_default();
+    let _ = tokio::time::timeout(
+        std::time::Duration::from_secs(3),
+        crate::relay::shutdown_profiles(&profiles),
+    )
+    .await;
+}
+
 #[tauri::command]
-pub fn quit_app(app: AppHandle) -> AppResult<()> {
+pub async fn quit_app(app: AppHandle, state: State<'_, AppState>) -> AppResult<()> {
+    best_effort_relay_shutdown(&state).await;
     arm_allow_exit();
     app.exit(0);
     Ok(())
