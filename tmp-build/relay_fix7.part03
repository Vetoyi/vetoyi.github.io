+async fn check_relay_health(
+    client: &reqwest::Client,
+    relay_base: &str,
+    expected_service: &str,
+    expect_backend_online: bool,
+) -> (bool, String) {
+    let url = public_endpoint(relay_base, "/__ctm/health");
+    let (code, payload) = match fetch_json(client, &url).await {
+        Ok(value) => value,
+        Err(detail) => return (false, detail),
+    };
+    let ok_flag = payload.get("ok").and_then(|v| v.as_bool()).unwrap_or(false);
+    let version = payload
+        .get("relayVersion")
+        .and_then(|v| v.as_str())
+        .unwrap_or("");
+    let service = payload
+        .get("service")
