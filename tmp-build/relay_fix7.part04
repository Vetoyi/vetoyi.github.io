+        .and_then(|v| v.as_str())
+        .unwrap_or("");
+    let backend = payload
+        .get("backend")
+        .and_then(|v| v.as_str())
+        .unwrap_or("");
+    let expires = payload
+        .get("expiresIn")
+        .and_then(|v| v.as_u64())
+        .unwrap_or(0);
+    let expected_backend = if expect_backend_online { "online" } else { "offline" };
+    let ok = ok_flag
+        && version == "1"
+        && service == expected_service
+        && backend == expected_backend;
+    (
+        ok,
+        format!(
+            "HTTP {code}; Relay v{version}; service={service}; backend={backend}; lease={expires}s; expected_backend={expected_backend}"
+        ),
+    )
 }
 
