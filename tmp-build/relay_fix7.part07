@@ -377,3 +440,42 @@ fn computed_public_url(
     }
     public_url.trim_end_matches('/').to_string()
 }
+
+
+#[cfg(test)]
+mod relay_model_tests {
+    use super::*;
+
+    #[test]
+    fn relay_is_canonical_but_quick_url_remains_transport() {
+        let mut profile = WorkspaceProfile::new("C:/repo".into(), Some("repo".into()));
+        profile.tunnel.tunnel_type = "cloudflare".into();
+        profile.tunnel.cloudflare_mode = "quick".into();
+        profile.tunnel.public_url = "https://random.trycloudflare.com".into();
+        profile.tunnel.relay = RelayConfig {
+            enabled: true,
+            public_url: "https://ctm-relay.example.workers.dev".into(),
+            ..RelayConfig::default()
+        };
+        assert_eq!(profile.effective_public_url(), "https://random.trycloudflare.com");
+        assert_eq!(profile.mcp_canonical_public_url(), "https://ctm-relay.example.workers.dev");
+        assert_eq!(profile.public_endpoint(), "https://ctm-relay.example.workers.dev/mcp");
+    }
+
+    #[test]
+    fn relay_never_overrides_named_or_non_cloudflare_tunnel() {
+        let mut profile = WorkspaceProfile::new("C:/repo".into(), Some("repo".into()));
+        profile.tunnel.relay = RelayConfig {
+            enabled: true,
+            public_url: "https://ctm-relay.example.workers.dev".into(),
+            ..RelayConfig::default()
+        };
+        profile.tunnel.tunnel_type = "frp".into();
+        profile.tunnel.public_url = "https://frp.example.com".into();
+        assert!(!profile.mcp_relay_enabled());
+        profile.tunnel.tunnel_type = "cloudflare".into();
+        profile.tunnel.cloudflare_mode = "named".into();
+        profile.tunnel.public_url = "https://named.example.com".into();
+        assert!(!profile.mcp_relay_enabled());
+    }
+}
