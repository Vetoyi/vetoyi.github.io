const RELAY_DEPLOYMENT_VERSION: u32 = 1;
const RELAY_LEASE_SECONDS: u32 = 300;
const RELAY_RENEW_SECONDS: u64 = 90;
const CLOUDFLARE_API_BASE: &str = "https://api.cloudflare.com/client/v4";
const SECURE_SERVICE: &str = "com.codingtools.mcp.desktop.relay";
const WORKER_SOURCE: &str = include_str!("worker.mjs");
static LAST_GENERATION: AtomicU64 = AtomicU64::new(0);

struct LeaseTask {
    target: String,
    handle: tauri::async_runtime::JoinHandle<()>,
}

static LEASE_TASKS: LazyLock<AsyncMutex<HashMap<String, LeaseTask>>> =
    LazyLock::new(|| AsyncMutex::new(HashMap::new()));

fn lease_key(workspace_id: &str, kind: TunnelServiceKind) -> String {
    format!("{}:{}", workspace_id, service_name(kind))
}

